# --- Database (Prisma + PostgreSQL) -------------------------------------------
# Free options: Supabase (https://supabase.com) or Neon (https://neon.tech) —
# create a project, copy its PostgreSQL connection string here.
# Use the pooled connection string if the provider offers one.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Access --------------------------------------------------------------------
# There are NO user accounts and no auth secret. Each book is protected by
# its own invite code (generated server-side when the book is created);
# whoever holds the code or the share link can open the book. Nothing to
# configure here.

# --- AI features (optional, OpenAI-compatible) ---------------------------------
# Without a key: voice-parse and amount suggestions fall back to the built-in
# local Vietnamese parser (same fallback the original host used), and photo
# extraction is disabled — the API answers 503 and the UI shows an honest error.
OPENAI_API_KEY=""
AI_TRANSLATE_BASE_URL="https://api.openai.com/v1"
AI_TRANSLATE_MODEL="gpt-4o-mini"
# Optional overrides (chat and vision can use different models):
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_CHAT_MODEL="gpt-4o-mini"
# OPENAI_VISION_MODEL="gpt-4o-mini"

# --- Client ---------------------------------------------------------------------
# "http" (default) = the built-in API routes.
# "mock" = in-memory demo data, no server or database needed.
NEXT_PUBLIC_SODAM_API_MODE="http"

# Public base URL of the deployed site (no trailing slash). Used for SEO
# metadata (canonical, Open Graph), sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://your-sodam-domain.example"
